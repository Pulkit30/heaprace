# Copy to .env and fill in. Neon variables are written to .env.local by `neon link` / `neon env pull`.

# Written by the Neon CLI (.env.local)
DATABASE_URL=            # pooled connection, used by the app
DATABASE_URL_UNPOOLED=   # direct connection, used for migrations
NEON_AUTH_BASE_URL=

# Yours (.env): generate with `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

# Server judge (Phase 3). Leave JUDGE0_URL empty in development to judge with your local python3.
# Option A, self-hosted Judge0 on your own server:
#   JUDGE0_URL=http://your-server-ip:2358
#   JUDGE0_AUTH_TOKEN=the AUTHN_TOKEN from judge0.conf
# Option B, hosted Judge0 on RapidAPI:
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_RAPIDAPI_KEY=your RapidAPI key
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
# Python language id on your Judge0 (71 = Python 3.8 on Judge0 CE)
JUDGE0_PYTHON_LANGUAGE_ID=71
